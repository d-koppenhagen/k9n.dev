# pnpm configuration – versioned so the same policies apply to every
# developer and CI pipeline.

# Treat peer-dependency conflicts as errors instead of silently resolving them.
strict-peer-dependencies=true

# Do not auto-install peer dependencies; they must be declared explicitly.
auto-install-peers=false

# Verify the integrity of the content-addressable store on every install.
verify-store-integrity=true

# Prefer the highest available version when resolving ranges.
resolution-mode=highest

# Pin exact versions when adding dependencies (no ^ or ~ ranges) for
# reproducible installs. Updates are handled deliberately via Renovate.
save-exact=true

# NOTE: Lifecycle scripts of dependencies are blocked by pnpm 10+ by default.
# Do NOT add `ignore-scripts=true` here — it would also block the packages
# explicitly approved via `allowBuilds` in pnpm-workspace.yaml and break
# native binaries (e.g. esbuild). The release-age quarantine lives in
# pnpm-workspace.yaml (`minimumReleaseAge`).
