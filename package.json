{
  "name": "k9n-dev",
  "version": "0.0.0",
  "description": "k9n.dev website",
  "author": "Danny Koppenhagen <mail@k9n.dev> (https://k9n.dev)",
  "homepage": "https://github.com/d-koppenhagen/k9n.dev",
  "bugs": {
    "url": "https://github.com/d-koppenhagen/k9n.dev/issues",
    "email": "mail@k9n.dev"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration=development-en",
    "build": "ng build",
    "lint": "ng lint",
    "test": "ng test",
    "e2e": "ng e2e",
    "e2e:ui": "pnpm exec playwright test --ui",
    "build:content": "pnpm exec tsx scripts/build-content.ts",
    "build:deploy": "pnpm run build:content && ng build && pnpm exec tsx scripts/post-build.ts",
    "atproto:sync": "node --env-file=.env.local node_modules/.bin/tsx scripts/atproto-sync.ts",
    "atproto:sync:dry": "DRY_RUN=true node --env-file=.env.local node_modules/.bin/tsx scripts/atproto-sync.ts",
    "atproto:sync:recreate": "node --env-file=.env.local node_modules/.bin/tsx scripts/atproto-sync.ts --recreate",
    "i18n:extract": "ng extract-i18n --output-path=src/locale",
    "preview": "pnpm run i18n:extract && pnpm run build:deploy && pnpm run serve:preview",
    "serve:preview": "pnpm exec tsx scripts/serve-static.ts",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:k9n-dev": "node dist/k9n-dev/server/server.mjs",
    "storybook": "ng run k9n-dev:storybook",
    "build-storybook": "ng run k9n-dev:build-storybook"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/aria": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/localize": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "22.2.0",
    "express": "5.2.1",
    "mermaid": "12.1.0",
    "ngxtension": "7.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular-devkit/architect": "0.2202.0",
    "@angular-devkit/build-angular": "22.2.0",
    "@angular-devkit/core": "22.2.0",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/platform-browser-dynamic": "22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@k9n/eslint-plugin-prefer-implicit": "0.4.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular-vite": "10.6.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "angular-eslint": "22.5.0",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "gray-matter": "4.0.3",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "marked-gfm-heading-id": "4.1.4",
    "marked-shiki": "1.2.1",
    "playwright-ng-schematics": "22.1.2",
    "prettier": "3.9.9",
    "shiki": "4.5.0",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zone.js": "0.16.3"
  }
}
